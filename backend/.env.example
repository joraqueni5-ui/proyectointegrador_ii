APP_NAME="PROINPA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=backend_db
DB_USERNAME=postgres
DB_PASSWORD=your_password

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Local development default: no external SMTP required.
# Laravel writes the OTP email to storage/logs/laravel.log and,
# only when OTP_DEBUG=true + APP_ENV=local, the frontend shows the code.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="noreply@proinpa.local"
MAIL_FROM_NAME="${APP_NAME}"

OTP_DEBUG=true
OTP_EXPIRES_MINUTES=15

FRONTEND_URL=http://localhost:5173

# Servicio de Inteligencia Artificial (FastAPI) en ejecución local
CNN_SERVICE_URL=http://127.0.0.1:8001
